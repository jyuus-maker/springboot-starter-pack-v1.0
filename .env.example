# ==============================================================================
# [REHMIA 배포 환경설정 템플릿 - .env.example]
# 본 파일을 복사하여 .env 파일을 생성한 뒤 실제 운영 환경에 맞게 값을 설정하세요.
# ==============================================================================

# 데이터베이스 설정
POSTGRES_DB=shopdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=My123456789!

# 외부 노출 포트 (기본 80)
APP_PORT=80
